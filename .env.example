# ---- required -------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/roomiq
JWT_SECRET=generate-with-openssl-rand-base64-48

# ---- app ------------------------------------------------------------------
PORT=8080
NODE_ENV=production
APP_TIMEZONE=Asia/Kolkata
PUBLIC_URL=https://roomiq-uneecops.azurewebsites.net   # used in email links
COOKIE_SECURE=true
SESSION_HOURS=12
PGSSL=true                      # Azure Database for PostgreSQL requires TLS

# ---- first administrator (created on every boot of the seed script) -------
SEED_ADMIN_EMAIL=admin@uneecops.in
SEED_ADMIN_PASSWORD=change-me-before-go-live
SEED_DEMO_DATA=false            # true only for a demo environment

# ---- email ----------------------------------------------------------------
# MAIL_DRIVER=log  → nothing is sent, everything is recorded in the outbox
# MAIL_DRIVER=smtp → Microsoft 365, Azure Communication Services SMTP, SendGrid…
MAIL_DRIVER=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=uneerooms@uneecops.in
SMTP_PASS=
MAIL_FROM=UneeRooms <uneerooms@uneecops.in>
MAIL_ADMIN_FALLBACK=facilities@uneecops.in
